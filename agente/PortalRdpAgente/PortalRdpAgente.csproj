<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- App de escritorio sin consola (corre en segundo plano con ícono en la bandeja). -->
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>PortalRdpAgente</AssemblyName>
    <RootNamespace>PortalRdpAgente</RootNamespace>
    <Version>1.0.0</Version>

    <!-- Publicación: un solo .exe autocontenido para instalar sin .NET en la PC destino.
         Publicar con:  dotnet publish -c Release
         (RID y self-contained ya están fijados abajo). -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
  </PropertyGroup>

</Project>
